# Variables read by ai-engineer-service (names only). Copy to .env (git-ignored).
# Registry: config/env.registry.yaml. Values: BellLabs/.secrets/aieng-db.env.

# API origin of the AI Engineer Supabase project (https://<ref>.supabase.co, or the lab stack's http://127.0.0.1:<port>).
AIENG_DB_URL=
# Public key, used with the caller's own session.
AIENG_DB_PUBLISHABLE_KEY=
# Service key; server processes only (byte custody and worker calls).
AIENG_DB_SECRET_KEY=
# Project ref; must appear in the AIENG_DB_URL host. Optional only for a loopback lab URL.
AIENG_DB_PROJECT_REF=

# Service processes (optional; defaults shown in docs/ENVIRONMENT.md).
# AIENG_API_HOST=
# AIENG_API_PORT=
# AIENG_MCP_HOST=
# AIENG_MCP_PORT=
# Generated schema workspace for schema navigation; default: ../ai-engineer-db-contract/workspace when it exists.
# AIENG_SCHEMA_WORKSPACE_DIR=

# Out-of-process clients (CLI, local MCP server). Never commit a token.
# AIENG_API_URL=
# AIENG_ACCESS_TOKEN=
# AIENG_CLIENT_TOKEN=
