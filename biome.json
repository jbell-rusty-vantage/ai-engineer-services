{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["apps/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "!**/dist", "!**/node_modules", "!**/.turbo"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120, "lineEnding": "auto" },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "json": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
