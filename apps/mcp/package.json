{
  "name": "@aiengineer/service-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ai-engineer-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/stdio.ts src/remote.ts --format esm --clean && tsc -p tsconfig.build.json --emitDeclarationOnly --rootDir src --outDir dist",
    "dev": "tsx watch --env-file-if-exists=../../.env src/remote.ts",
    "start:remote": "node --env-file-if-exists=../../.env dist/remote.js",
    "start:stdio": "node dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiengineer/service-application": "workspace:*",
    "@aiengineer/service-client": "workspace:*",
    "@aiengineer/service-contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "fastify": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
